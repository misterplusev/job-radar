+name: job-radar-pipeline

+run-name: job-radar ${{ inputs.scheduler_slot || github.event_name }}

+

+on:

+  workflow_dispatch:

+    inputs:

+      scheduler_slot:

+        description: UTC hourly slot assigned by the Cloudflare scheduler

+        required: false

+        type: string

+      trigger_source:

+        description: Dispatch origin

+        required: false

+        default: manual

+        type: string

+      full_refresh:

+        description: Rewrite stored descriptions for every posting (heavy; manual use only)

+        required: false

+        default: false

+        type: boolean

+

+# Cloudflare abet-jobs-scheduler owns the schedule; no second GitHub cron.

+concurrency:

+  group: job-radar-pipeline

+  cancel-in-progress: false

+

+permissions:

+  contents: read

+

+jobs:

+  pipeline:

+    runs-on: ubuntu-latest

+    timeout-minutes: 45

+    steps:

+      - uses: actions/checkout@v4

+      - uses: actions/setup-python@v5

+        with:

+          python-version: '3.12'

+      - name: Install dependencies

+        run: pip install -r requirements.txt

+      - name: Regression checks

+        run: python -m unittest discover -s tests -v

+      # Schema is NOT applied here. Running DDL and a PostgREST schema reload before

+      # every scrape let a slow database block ingestion entirely (2026-11-11 outage).

+      # Apply schema changes deliberately with the manual apply-schema workflow.

+      - name: Scrape, reconcile, and deliver pending notifications

+        env:

+          SUPABASE_URL: ${{ secrets.SUPABASE_URL }}

+          SUPABASE_SERVICE_ROLE_KEY: ${{ secrets.SUPABASE_SERVICE_ROLE_KEY }}

+          JOBRADAR_MODULE: robotics

+          DISCORD_WEBHOOK_JOBS: ${{ secrets.DISCORD_WEBHOOK_JOBS }}

+          JOBRADAR_TRIGGER: ${{ inputs.trigger_source || github.event_name }}

+          JOBRADAR_SCHEDULER_SLOT: ${{ inputs.scheduler_slot }}

+          JOBRADAR_FULL_REFRESH: ${{ inputs.full_refresh && '1' || '' }}

+        run: python -u run.py ingest

+      - name: Render dashboard artifact

+        if: ${{ !cancelled() }}

+        env:

+          SUPABASE_URL: ${{ secrets.SUPABASE_URL }}

+          SUPABASE_SERVICE_ROLE_KEY: ${{ secrets.SUPABASE_SERVICE_ROLE_KEY }}

+        run: python run.py render --out out/dashboard.html

+      - uses: actions/upload-artifact@v4

+        if: ${{ always() }}

+        with:

+          name: job-radar-receipt

+          path: |

+            out/dashboard.html

+            data/runtime/latest_manifest.json

+            data/runtime/workday-http/*.jsonl

+          if-no-files-found: warn

+          retention-days: 7

